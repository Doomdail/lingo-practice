{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.5",
  "minimum_chrome_version": "106",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  },
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "options_ui": { "page": "library.html", "open_in_tab": true },
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "web_accessible_resources": [
    { "resources": ["styles.css"], "matches": ["https://www.youtube.com/*"] }
  ]
}
